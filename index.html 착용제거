      const faqButton = document.getElementById('faqButton');
      const faqModal = document.getElementById('faqModal');
      const faqClose = document.getElementById('faqClose');
      const faqSearch = document.getElementById('faqSearch');
      const faqItems = [...document.querySelectorAll('.faq-item')];
      const faqCount = document.getElementById('faqCount');
      const faqEmpty = document.getElementById('faqEmpty');

      const copy = {
        1: {
          title: '오른손 중지로 아랫눈꺼풀을 내리세요',
          body: '표시된 아랫눈꺼풀을 오른손 중지로 잡고 아래로 드래그하세요.',
          feedback: '파란 원에 오른손 중지를 놓고 아래로 내려보세요.'
        },
        2: {
          title: '오른손 검지로 렌즈를 내리세요',
          body: '렌즈를 아래 흰자위로 이동하면 눈동자가 위로 향하면서 상안검도 자동으로 열립니다.',
          feedback: '오른손 검지를 렌즈 아래쪽에 놓고 아래로 밀어주세요.'
        },
        3: {
          title: '오른손 검지와 엄지로 렌즈를 빼세요',
          body: '손톱이 아닌 검지와 엄지의 지문 면을 렌즈 양쪽 테두리에 놓고 안쪽으로 살짝 모으세요.',
          feedback: '손톱 말고 지문 면을 사용하세요. 왼쪽은 검지, 오른쪽은 엄지입니다.'
