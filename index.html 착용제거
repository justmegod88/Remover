      const sideViewButton = document.getElementById('sideViewButton');

      // 기존 버튼형 착용 버전은 아래 로직과 DOM에 그대로 보존하고,
      // 새 기본 버전에서는 렌즈 선택 뒤 측면 한 화면에서 직접 드래그한다.
      const DIRECT_SIDE_WEAR = true;
      const sidePointerDrags = new Map();

      const wearCopy = {
        1: {
          title: '렌즈의 앞뒤를 먼저 확인 후 적절한 렌즈를 선택해 주세요',
          body: '가장자리가 위로 선 둥근 그릇 모양이 올바른 방향입니다.',
          feedback: '두 렌즈 중 올바른 앞면 모양을 선택하세요.'
        },
        2: {
          title: DIRECT_SIDE_WEAR ? '측면에서 눈꺼풀을 벌리고 렌즈를 직접 넣으세요' : '왼손 중지와 오른손 중지로 눈꺼풀을 벌리세요',
          body: DIRECT_SIDE_WEAR ? '왼손 중지는 위로, 오른손 중지는 아래로 드래그해 고정하고 오른손 검지의 렌즈를 각막 중심으로 움직이세요.' : '왼손 중지는 윗눈꺼풀 위 피부를 위로, 오른손 중지는 아랫눈꺼풀 아래 피부를 아래로 당기세요.',
          feedback: DIRECT_SIDE_WEAR ? '위 손가락은 위로, 아래 손가락은 아래로 움직인 뒤 렌즈를 든 검지를 왼쪽으로 드래그하세요.' : '위 파란 원은 왼손 중지, 아래 파란 원은 오른손 중지로 드래그하세요.'
        },
        3: {
          title: '측면에서 렌즈와 각막을 일직선으로 맞추세요',
          body: '왼손 중지로 윗눈꺼풀, 오른손 중지로 아랫눈꺼풀을 고정하고 오른손 검지 위 렌즈의 각도를 맞추세요.',
          feedback: '눈꺼풀 고정 손가락은 그대로 두고, 렌즈를 든 검지만 각막 중심으로 움직이세요.'
        },
        4: {
          title: DIRECT_SIDE_WEAR ? '렌즈가 각막에 고르게 안착됐어요' : '손가락을 떼고 천천히 눈을 깜빡이세요',
          body: DIRECT_SIDE_WEAR ? '렌즈가 각막 곡면에 맞게 닿았습니다. 검지를 천천히 떼면 착용 연습이 완료됩니다.' : '렌즈가 눈에 닿았어요. 한 번 천천히 깜빡여 렌즈를 중앙에 안착시키세요.',
          feedback: DIRECT_SIDE_WEAR ? '착용 성공! 렌즈가 측면에서 각막에 고르게 안착했어요.' : '좋아요! 이제 아래 버튼을 눌러 천천히 깜빡여보세요.'
        }
      };

      const SIDE_ROTATION_PIVOT_X = 287;
      const SIDE_ROTATION_PIVOT_Y = 238;

      const wearState = {
        step: 1,
        upper: 0,
        lower: 0,
        lensX: 200,
        lensY: 420,
        drag: null,
        failures: 0,
        attemptLocked: false,
        success: false,
        blinking: false,
        angle: 15,
        approach: 0,
        inserting: false,
        lastFail: 'lid',
        viewMode: 'side'
      };

      function vibrate(pattern = 20) {
        if ('vibrate' in navigator) navigator.vibrate(pattern);
      }

      function toWearPoint(event) {
        const point = wearSvg.createSVGPoint();
        point.x = event.clientX;
        point.y = event.clientY;
        const matrix = wearSvg.getScreenCTM();
        return matrix ? point.matrixTransform(matrix.inverse()) : { x: 0, y: 0 };
      }

      function toSidePoint(event) {
        const point = sideViewScene.createSVGPoint();
        point.x = event.clientX;
        point.y = event.clientY;
        const matrix = sideViewScene.getScreenCTM();
        return matrix ? point.matrixTransform(matrix.inverse()) : { x: 0, y: 0 };
      }

      function setWearFeedback(message, type = '') {
        wearFeedback.textContent = message;
        wearFeedback.className = `feedback${type ? ` ${type}` : ''}`;
      }

      function openingPercent() {
        return Math.round(Math.min(wearState.upper, wearState.lower) / 60 * 100);
      }

      function renderWearGeometry() {
        const topOuter = 145 - wearState.upper * 1.35;
        const topInner = 158 - wearState.upper * 1.18;
        const bottomOuter = 355 + wearState.lower * 1.35;
        const bottomInner = 342 + wearState.lower * 1.18;
        const opening = `M24,250 Q200,${topOuter} 376,250 Q200,${bottomOuter} 24,250Z`;

        wearEyeWhite.setAttribute('d', opening);
        wearEyeClipPath.setAttribute('d', opening);
        wearUpperOuter.setAttribute('d', `M24,250 Q200,${topOuter} 376,250`);
        wearUpperInner.setAttribute('d', `M31,245 Q200,${topInner} 369,245`);
        wearUpperHit.setAttribute('d', `M24,250 Q200,${topOuter} 376,250`);
        wearLowerOuter.setAttribute('d', `M24,250 Q200,${bottomOuter} 376,250`);
        wearLowerInner.setAttribute('d', `M31,255 Q200,${bottomInner} 369,255`);
        wearLowerHit.setAttribute('d', `M24,250 Q200,${bottomOuter} 376,250`);
        wearLowerCrease.setAttribute('d', `M46 291 Q200,${390 + wearState.lower * .82} 354,291`);
        wearUpperLashes.setAttribute('transform', `translate(0 ${-wearState.upper * .86})`);
        wearLowerLashes.setAttribute('transform', `translate(0 ${wearState.lower * .86})`);
        wearLens.setAttribute('transform', `translate(${wearState.lensX - 200} ${wearState.lensY - 250})`);

        const upperHandleY = topInner;
        const lowerHandleY = bottomInner;
        wearUpperHandle.setAttribute('cy', upperHandleY);
        wearUpperHandleText.setAttribute('y', upperHandleY - 4);
        wearUpperArrow.setAttribute('d', `M200 ${upperHandleY - 27} L200 ${upperHandleY - 55}`);
        wearLowerHandle.setAttribute('cy', lowerHandleY);
        wearLowerHandleText.setAttribute('y', lowerHandleY - 4);
        wearLowerArrow.setAttribute('d', `M200 ${lowerHandleY + 27} L200 ${lowerHandleY + 55}`);

        const percent = openingPercent();
        openingMeterText.textContent = `현재 눈 벌림 ${percent}%`;
        openingMeterFill.style.width = `${percent}%`;
      }

      function renderSideGeometry() {
        // 정면에서 사용자가 벌린 위·아래 눈꺼풀의 양을 측면 노출 범위에도 그대로 반영한다.
        const upperRatio = Math.max(0, Math.min(1, wearState.upper / 60));
        const lowerRatio = Math.max(0, Math.min(1, wearState.lower / 60));
        // 0%는 감긴 눈이 아니라 자연스러운 기본 노출, 100%는 충분히 벌린 상태다.
        const upperC1 = 218 - upperRatio * 27;
        const upperC2 = 210 - upperRatio * 32;
        const upperShoulder = 220 - upperRatio * 22;
        const lowerC1 = 282 + lowerRatio * 27;
        const lowerC2 = 290 + lowerRatio * 32;
        const lowerShoulder = 280 + lowerRatio * 22;
        const frontControl = 194 + Math.min(upperRatio, lowerRatio) * 16;
        const sideOpening = `M24 250 C66 ${upperC1} 120 ${upperC2} 166 ${upperShoulder} Q${frontControl} 250 166 ${lowerShoulder} C120 ${lowerC2} 66 ${lowerC1} 24 250Z`;
        const lidOutline = `M24 250 C66 ${upperC1} 120 ${upperC2} 166 ${upperShoulder} M24 250 C66 ${lowerC1} 120 ${lowerC2} 166 ${lowerShoulder}`;

        sideApertureClipPath.setAttribute('d', sideOpening);
        sideEyeOpeningOutline.setAttribute('d', lidOutline);
        sideUpperLidDetail.setAttribute('d', `M55 ${upperC1 + 10} C88 ${upperC2 + 2} 124 ${upperC2 + 5} 153 ${upperShoulder - 4}`);
        sideLowerLidDetail.setAttribute('d', `M55 ${lowerC1 - 10} C88 ${lowerC2 - 2} 124 ${lowerC2 - 5} 153 ${lowerShoulder + 4}`);
        sideUpperRim.setAttribute('d', `M30 250 C68 ${upperC1 + 4} 120 ${upperC2 + 4} 165 ${upperShoulder + 2}`);
        sideLowerRim.setAttribute('d', `M30 250 C68 ${lowerC1 - 4} 120 ${lowerC2 - 4} 165 ${lowerShoulder - 2}`);
        sideUpperLashes.setAttribute('transform', `translate(0 ${-upperRatio * 30})`);
        sideLowerLashes.setAttribute('transform', `translate(0 ${lowerRatio * 30})`);
        sideUpperLashWarningLine.setAttribute('transform', `translate(0 ${-upperRatio * 30})`);
        sideLowerLashWarningLine.setAttribute('transform', `translate(0 ${lowerRatio * 30})`);

        // 눈꺼풀을 잡은 손가락도 드래그한 거리만큼 함께 움직여 고정된 느낌을 준다.
        const upperHandOffset = -upperRatio * 22;
        const lowerHandOffset = lowerRatio * 22;
        sideUpperHoldingHand.setAttribute('transform', `translate(0 ${upperHandOffset})`);
        sideUpperHoldingGuide.setAttribute('transform', `translate(0 ${upperHandOffset})`);
        sideLowerHoldingHand.setAttribute('transform', `translate(0 ${lowerHandOffset})`);
        sideLowerHoldingGuide.setAttribute('transform', `translate(0 ${lowerHandOffset})`);

        sideInsertionAssembly.setAttribute('transform', `translate(${wearState.approach} 0) rotate(${wearState.angle} ${SIDE_ROTATION_PIVOT_X} ${SIDE_ROTATION_PIVOT_Y})`);
        sideAngleGuide.setAttribute('transform', `translate(${wearState.approach} 0)`);
        const showAngleGuide = DIRECT_SIDE_WEAR
          ? wearState.step === 2 && wearState.upper >= 42 && wearState.lower >= 42 && !wearState.inserting && !wearState.success
          : wearState.step === 3 && wearState.viewMode === 'side' && !wearState.inserting && !wearState.success;
        sideAngleGuide.style.opacity = showAngleGuide ? '.72' : '0';
        angleSlider.value = String(wearState.angle);
        angleValue.textContent = `${wearState.angle > 0 ? '+' : ''}${wearState.angle}°`;

        const absoluteAngle = Math.abs(wearState.angle);
        if (absoluteAngle <= 6) {
          angleStatus.textContent = '정렬 양호 · 각막 정면과 거의 평행해요';
          angleValue.style.background = '#dff7ed';
          angleValue.style.color = '#087353';
        } else if (wearState.angle < 0) {
          angleStatus.textContent = '윗부분이 먼저 닿을 수 있어요';
          angleValue.style.background = '#ffe8e9';
          angleValue.style.color = '#a82f3a';
        } else {
          angleStatus.textContent = '아랫부분이 먼저 닿을 수 있어요';
          angleValue.style.background = '#ffe8e9';
          angleValue.style.color = '#a82f3a';
        }
        updateDirectWearPhaseUI();
      }

      function setAngle(value) {
        if (wearState.inserting) return;
        wearState.angle = Math.max(-25, Math.min(25, Math.round(Number(value))));
        sideTopContact.style.opacity = '0';
        sideBottomContact.style.opacity = '0';
        sideContactSuccess.style.opacity = '0';
        sideLashWarning.style.opacity = '0';
        renderSideGeometry();
      }

      function randomStartAngle() {
        const choices = [-20, -15, -10, 10, 15, 20];
        return choices[Math.floor(Math.random() * choices.length)];
      }

      function setPracticeView(mode) {
        wearState.viewMode = mode;
        const sideActive = (DIRECT_SIDE_WEAR && (wearState.step === 2 || wearState.step === 4)) || (wearState.step === 3 && mode === 'side');
        frontViewButton.classList.toggle('active', !sideActive);
        sideViewButton.classList.toggle('active', sideActive);
        frontViewButton.setAttribute('aria-pressed', String(!sideActive));
        sideViewButton.setAttribute('aria-pressed', String(sideActive));

        // iPhone Safari에서도 확실히 한 화면만 보이도록 hidden과 inline display를 함께 적용한다.
        wearSvg.hidden = sideActive;
        wearSvg.style.display = sideActive ? 'none' : 'block';
        sideViewStage.hidden = !sideActive;
        sideViewStage.style.display = sideActive ? 'block' : 'none';
        openingMeter.hidden = DIRECT_SIDE_WEAR || !(wearState.step === 2 || (wearState.step === 3 && !sideActive));
      }

      function directDisplayStep() {
        if (wearState.step === 1) return 1;
        if (wearState.step === 2) return wearState.upper >= 42 && wearState.lower >= 42 ? 3 : 2;
        return 3;
      }

      function updateDirectWearPhaseUI() {
        if (!DIRECT_SIDE_WEAR) return;
        const displayStep = directDisplayStep();
        wearStepNumber.textContent = displayStep;
        directWearProgress.forEach((item, index) => {
          const number = index + 1;
          item.classList.toggle('active', number === displayStep);
          item.classList.toggle('done', number < displayStep || wearState.success);
        });

        if (wearState.step === 2 && displayStep === 2) {
          wearInstructionTitle.textContent = '측면에서 위·아래 눈꺼풀을 충분히 벌리세요';
          wearInstructionBody.textContent = '왼손 중지는 위로, 오른손 중지는 아래로 드래그하세요. 손을 떼어도 벌린 위치가 유지됩니다.';
        } else if (wearState.step === 2 && displayStep === 3) {
          wearInstructionTitle.textContent = '렌즈를 든 오른손 검지를 각막 중심으로 움직이세요';
          wearInstructionBody.textContent = '검지를 왼쪽으로 천천히 드래그하고, 위아래 움직임으로 렌즈 면이 각막 정면과 나란해지도록 맞추세요.';
        }
      }

      function renderWearStep() {
        const current = wearCopy[wearState.step];
        const displayStep = DIRECT_SIDE_WEAR ? directDisplayStep() : wearState.step;
        wearStepNumber.textContent = displayStep;
        wearInstructionTitle.textContent = current.title;
        wearInstructionBody.textContent = current.body;
        setWearFeedback(current.feedback);

        wearProgress.forEach((item, index) => {
          const number = index + 1;
          item.classList.toggle('active', number === wearState.step);
          item.classList.toggle('done', number < wearState.step || wearState.success);
        });

        directWearProgress.forEach((item, index) => {
          const number = index + 1;
          item.classList.toggle('active', number === displayStep);
          item.classList.toggle('done', number < displayStep || wearState.success);
        });

        orientationActions.hidden = wearState.step !== 1;
        openingActions.hidden = DIRECT_SIDE_WEAR || wearState.step !== 2;
        lensActions.hidden = DIRECT_SIDE_WEAR || wearState.step !== 3;
        blinkActions.hidden = DIRECT_SIDE_WEAR || wearState.step !== 4;
        wearControlDock.hidden = DIRECT_SIDE_WEAR && wearState.step !== 1;
        openingMeter.hidden = DIRECT_SIDE_WEAR || wearState.step !== 2;
        const sidePracticeStep = (DIRECT_SIDE_WEAR && (wearState.step === 2 || wearState.step === 4)) || wearState.step === 3;
        wearVideoPip.hidden = DIRECT_SIDE_WEAR || sidePracticeStep;
        wearVideoPip.style.display = DIRECT_SIDE_WEAR || sidePracticeStep ? 'none' : '';
        wearFeedback.hidden = DIRECT_SIDE_WEAR && wearState.step === 1;
        if (DIRECT_SIDE_WEAR && (wearState.step === 2 || wearState.step === 4)) {
          setPracticeView('side');
        } else if (wearState.step === 3) {
          setPracticeView(wearState.viewMode);
        } else if (DIRECT_SIDE_WEAR && wearState.step === 1) {
          wearSvg.hidden = true;
          wearSvg.style.display = 'none';
          sideViewStage.hidden = true;
          sideViewStage.style.display = 'none';
        } else {
          wearSvg.hidden = false;
          wearSvg.style.display = 'block';
          sideViewStage.hidden = true;
          sideViewStage.style.display = 'none';
        }
        wearLidGuides.style.opacity = wearState.step === 2 ? '1' : '0';
        wearLensGuide.style.opacity = '0';
        wearLens.style.opacity = '0';
        wearContactLens.style.opacity = wearState.step === 4 || wearState.success ? '.76' : '0';
        if (sidePracticeStep) renderSideGeometry();
        updateDirectWearPhaseUI();
      }

      function goWearStep(step) {
        const previousStep = wearState.step;
        wearState.step = step;
        wearState.drag = null;
        sidePointerDrags.clear();
        wearState.attemptLocked = false;
        if (DIRECT_SIDE_WEAR && step === 2) {
          wearState.approach = 0;
          wearState.inserting = false;
          wearState.viewMode = 'side';
          if (previousStep !== 2) wearState.angle = randomStartAngle();
          sideTopContact.style.opacity = '0';
          sideBottomContact.style.opacity = '0';
          sideContactSuccess.style.opacity = '0';
          sideLashWarning.style.opacity = '0';
        }
        if (step === 3) {
          wearState.lensX = 200;
          wearState.lensY = 420;
          wearState.approach = 0;
          wearState.inserting = false;
          wearState.viewMode = 'side';
          if (previousStep !== 3) wearState.angle = randomStartAngle();
          sideTopContact.style.opacity = '0';
          sideBottomContact.style.opacity = '0';
          sideContactSuccess.style.opacity = '0';
          sideLashWarning.style.opacity = '0';
        }
        if (step === 4) {
          wearState.lensX = 200;
          wearState.lensY = 250;
        }
        renderWearGeometry();
        renderWearStep();
        vibrate();
      }

      function resetWear() {
        wearState.step = 1;
        wearState.upper = 0;
        wearState.lower = 0;
        wearState.lensX = 200;
        wearState.lensY = 420;
        wearState.drag = null;
        wearState.failures = 0;
        wearState.attemptLocked = false;
        wearState.success = false;
        wearState.blinking = false;
        wearState.angle = 15;
        wearState.approach = 0;
        wearState.inserting = false;
        wearState.lastFail = 'lid';
        wearState.viewMode = 'side';
        sidePointerDrags.clear();
        wearCollision.style.opacity = '0';
        sideTopContact.style.opacity = '0';
        sideBottomContact.style.opacity = '0';
        sideContactSuccess.style.opacity = '0';
        sideLashWarning.style.opacity = '0';
        wearAttemptGuide.hidden = true;
        wearCompletion.classList.remove('visible');
        wearCompletion.setAttribute('aria-hidden', 'true');
        renderWearGeometry();
        renderWearStep();
      }

      function showWearAttemptGuide() {
        if (wearState.failures !== 2 && wearState.failures !== 4) return;
        wearAttemptBadge.textContent = `${wearState.failures}회`;
        if (wearState.lastFail === 'angle' && wearState.failures === 2) {
          wearAttemptTitle.textContent = '렌즈 면과 각막 정면을 나란히 맞추세요';
          wearAttemptBody.textContent = '손가락이 기울면 렌즈의 위쪽 또는 아래쪽 가장자리가 먼저 닿아 렌즈가 밀려나요. 측면 기준선과 렌즈가 나란해지도록 0°에 가깝게 조절한 뒤 다시 넣어보세요.';
        } else if (wearState.lastFail === 'angle') {
          wearAttemptTitle.textContent = '손가락 끝을 세운 상태부터 다시 확인하세요';
          wearAttemptBody.textContent = '잠시 쉬었다가 손가락 끝의 렌즈가 기울지 않았는지 옆에서 확인하세요. 렌즈 전체가 각막에 동시에 닿도록 각도를 맞춘 뒤 정면 방향으로 천천히 접근하세요.';
        } else if (wearState.failures === 2) {
          wearAttemptTitle.textContent = '속눈썹 뿌리 쪽을 잡아보세요';
          wearAttemptBody.textContent = '눈꺼풀 가장자리만 잡으면 손가락이 미끄러지고 눈이 충분히 열리지 않아요. 위·아래 속눈썹 뿌리에 가깝게 잡고 서로 반대 방향으로 더 벌린 뒤 다시 시도하세요.';
        } else {
          wearAttemptTitle.textContent = '잠시 쉬고, 눈 벌리기부터 다시 해보세요';
          wearAttemptBody.textContent = '눈을 여러 번 건드리면 반사적으로 감기기 쉬워요. 잠시 쉬었다가 거울을 보며 위·아래 눈꺼풀을 충분히 벌린 상태를 먼저 유지한 뒤 렌즈를 천천히 가져가세요.';
        }
        wearAttemptGuide.hidden = false;
      }

      function failWear(reason) {
        if (wearState.attemptLocked) return;
        wearState.attemptLocked = true;
        wearState.failures += 1;
        wearState.drag = null;

        let message;
        let lowerCollision = false;
        if (wearState.upper < 42 && wearState.lower < 42) {
          message = '위·아래 눈꺼풀을 충분히 벌리지 않아 렌즈가 속눈썹에 닿았어요.';
          lowerCollision = wearState.lower <= wearState.upper;
        } else if (wearState.lower < 42) {
          message = '아랫눈꺼풀이 충분히 내려가지 않아 아래 속눈썹에 렌즈가 걸렸어요.';
          lowerCollision = true;
        } else {
          message = '윗눈꺼풀이 충분히 올라가지 않아 눈이 감기며 위 속눈썹에 렌즈가 닿았어요.';
        }

        setWearFeedback(`${wearState.failures}회 실패 · ${message}`, 'error');
        wearCollisionLine.setAttribute('d', lowerCollision ? 'M68 297 Q200 367 332 297' : 'M68 203 Q200 133 332 203');
        wearCollisionText.setAttribute('y', lowerCollision ? '410' : '104');
        wearCollisionText.textContent = reason || '속눈썹에 닿았어요!';
        wearCollision.style.opacity = '1';
        wearCollision.classList.remove('lash-hit');
        void wearCollision.getBoundingClientRect();
        wearCollision.classList.add('lash-hit');
        vibrate([35, 45, 35]);

        wearState.lensX = 200;
        wearState.lensY = 420;
        renderWearGeometry();
        setTimeout(() => {
          wearCollision.style.opacity = '0';
          showWearAttemptGuide();
        }, 650);
      }

      function animateSideReturn(callback) {
        const startApproach = wearState.approach;
        const start = performance.now();
        const duration = 420;
        function animate(now) {
          const progress = Math.min(1, (now - start) / duration);
          const eased = 1 - Math.pow(1 - progress, 3);
          wearState.approach = startApproach * (1 - eased);
          renderSideGeometry();
          if (progress < 1) requestAnimationFrame(animate);
          else {
            wearState.approach = 0;
            wearState.inserting = false;
            wearState.attemptLocked = false;
            insertLensButton.disabled = false;
            insertLensButton.textContent = '이 각도로 넣기';
            renderSideGeometry();
            if (callback) callback();
          }
        }
        requestAnimationFrame(animate);
      }

      function recordSideFailure(type) {
        wearState.failures += 1;
        wearState.lastFail = type;
        const count = wearState.failures;

        sideTopContact.style.opacity = '0';
        sideBottomContact.style.opacity = '0';
        sideContactSuccess.style.opacity = '0';
        sideLashWarning.style.opacity = '0';

        if (type === 'lid') {
          const upperShort = wearState.upper < 42;
          const lowerShort = wearState.lower < 42;
          sideUpperLashWarningLine.style.opacity = upperShort ? '1' : '0';
          sideLowerLashWarningLine.style.opacity = lowerShort ? '1' : '0';
          sideLashWarning.style.opacity = '1';
          const bothShort = upperShort && lowerShort;
          const location = bothShort ? '위·아래 속눈썹' : upperShort ? '위 속눈썹' : '아래 속눈썹';
          sideLashWarningText.textContent = bothShort ? '위·아래 눈꺼풀을 모두 더 벌려주세요' : `${location}에 걸리지 않게 더 벌려주세요`;
          setWearFeedback(`${count}회 실패 · 눈을 충분히 벌리지 않아 렌즈가 ${location}에 닿았어요.`, 'error');
        } else {
          const topFirst = wearState.angle < 0;
          sideTopContact.style.opacity = topFirst ? '1' : '0';
          sideBottomContact.style.opacity = topFirst ? '0' : '1';
          const edge = topFirst ? '위쪽' : '아래쪽';
          setWearFeedback(`${count}회 실패 · 렌즈가 기울어 ${edge} 가장자리가 먼저 닿고 밀려났어요.`, 'error');
        }
        vibrate([35, 45, 35]);

        setTimeout(() => {
          animateSideReturn(() => {
            sideTopContact.style.opacity = '0';
            sideBottomContact.style.opacity = '0';
            sideLashWarning.style.opacity = '0';
            showWearAttemptGuide();
          });
        }, 720);
      }

      function firstSideContactApproach() {
        if (Math.abs(wearState.angle) < .01) return -92;
        const radians = wearState.angle * Math.PI / 180;
        const contactY = wearState.angle > 0 ? 302 : 198;
        const dx = 258 - SIDE_ROTATION_PIVOT_X;
        const dy = contactY - SIDE_ROTATION_PIVOT_Y;
        const rotatedContactX = SIDE_ROTATION_PIVOT_X + dx * Math.cos(radians) - dy * Math.sin(radians);
        return 166 - rotatedContactX;
      }

      function attemptSideInsertion() {
        if (wearState.step !== 3 || wearState.inserting || wearState.success) return;
        if (wearState.viewMode !== 'side') {
          setPracticeView('side');
          setTimeout(attemptSideInsertion, 180);
          return;
        }
        wearState.inserting = true;
        wearState.approach = 0;
        sideTopContact.style.opacity = '0';
        sideBottomContact.style.opacity = '0';
        sideContactSuccess.style.opacity = '0';
        sideLashWarning.style.opacity = '0';
        insertLensButton.disabled = true;
        insertLensButton.textContent = '각막으로 접근 중…';
        setWearFeedback('손가락의 각도를 유지하면서 각막 정면으로 천천히 접근합니다.');

        const start = performance.now();
        const duration = 620;
        const lidIsShort = wearState.upper < 42 || wearState.lower < 42;
        const firstContact = firstSideContactApproach();
        // 안검이 덜 열린 경우에는 렌즈가 각막까지 관통하지 않고 속눈썹 앞에서 멈춘다.
        const targetApproach = lidIsShort ? Math.max(firstContact, -76) : firstContact;
        function animate(now) {
          const progress = Math.min(1, (now - start) / duration);
          const eased = 1 - Math.pow(1 - progress, 3);
          wearState.approach = targetApproach * eased;
          renderSideGeometry();
          if (progress < 1) {
            requestAnimationFrame(animate);
            return;
          }

          if (wearState.upper < 42 || wearState.lower < 42) {
            recordSideFailure('lid');
          } else if (Math.abs(wearState.angle) > 6) {
            recordSideFailure('angle');
          } else {
            // 허용 범위 안의 미세한 기울기는 안착 순간 0°로 정렬해 곡면이 정확히 포개지게 한다.
            wearState.angle = 0;
            wearState.approach = -92;
            renderSideGeometry();
            sideContactSuccess.style.opacity = '1';
            setWearFeedback('정확해요! 렌즈 면이 각막 정면과 평행하게 고르게 닿았습니다.', 'success');
            vibrate([30, 35, 55]);
            setTimeout(() => {
              wearState.inserting = false;
              insertLensButton.disabled = false;
              insertLensButton.textContent = '이 각도로 넣기';
              goWearStep(4);
            }, 650);
          }
        }
        requestAnimationFrame(animate);
      }

      function finishWear() {
        if (wearState.success) return;
        wearState.success = true;
        wearProgress.forEach(item => {
          item.classList.add('done');
          item.classList.remove('active');
        });
        directWearProgress.forEach(item => {
          item.classList.add('done');
          item.classList.remove('active');
        });
        setWearFeedback('착용 성공! 눈을 충분히 벌려 속눈썹 접촉 없이 렌즈를 안착했어요.', 'success');
        wearLens.style.opacity = '0';
        wearContactLens.style.opacity = '.76';
        wearCompletion.classList.add('visible');
        wearCompletion.setAttribute('aria-hidden', 'false');
        vibrate([35, 40, 70]);
      }

      function blinkAndFinish() {
        if (wearState.blinking || wearState.success) return;
        wearState.blinking = true;
        blinkActions.hidden = true;
        const startUpper = wearState.upper;
        const startLower = wearState.lower;
        const start = performance.now();
        const duration = 720;

        function animate(now) {
          const progress = Math.min(1, (now - start) / duration);
          const close = Math.sin(progress * Math.PI);
          wearState.upper = startUpper - (startUpper + 64) * close;
          wearState.lower = startLower - (startLower + 64) * close;
          renderWearGeometry();
          if (progress < 1) requestAnimationFrame(animate);
          else {
            wearState.upper = startUpper;
            wearState.lower = startLower;
            wearState.blinking = false;
            renderWearGeometry();
            finishWear();
          }
        }
        requestAnimationFrame(animate);
      }

      function setMode(mode) {
        activeMode = mode;
        const wearing = mode === 'wear';
        wearPractice.hidden = !wearing;
        removalPractice.hidden = wearing;
        wearTab.classList.toggle('active', wearing);
        removalTab.classList.toggle('active', !wearing);
        wearTab.setAttribute('aria-selected', String(wearing));
        removalTab.setAttribute('aria-selected', String(!wearing));
        modeEyebrow.textContent = wearing ? 'WEARING PRACTICE' : 'REMOVAL PRACTICE';
        pageTitle.textContent = wearing ? '콘택트렌즈 착용 연습' : '콘택트렌즈 제거 연습';
      }

      document.getElementById('correctOrientation').addEventListener('click', () => goWearStep(2));
      document.getElementById('wrongOrientation').addEventListener('click', () => {
        const wrongCard = document.getElementById('wrongOrientation');
        wrongCard.classList.remove('invalid');
        void wrongCard.offsetWidth;
        wrongCard.classList.add('invalid');
        window.setTimeout(() => wrongCard.classList.remove('invalid'), 700);
        setWearFeedback('가장자리가 바깥으로 벌어진 렌즈는 뒤집힌 상태예요. 가장자리가 곧게 선 둥근 그릇 모양을 선택하세요.', 'error');
        vibrate([25, 35, 25]);
      });
      document.getElementById('tryOpening').addEventListener('click', () => goWearStep(3));
      document.getElementById('adjustOpening').addEventListener('click', () => goWearStep(2));
      document.getElementById('angleMinus').addEventListener('click', () => setAngle(wearState.angle - 5));
      document.getElementById('anglePlus').addEventListener('click', () => setAngle(wearState.angle + 5));
      angleSlider.addEventListener('input', event => setAngle(event.target.value));
      frontViewButton.addEventListener('click', () => setPracticeView('front'));
      sideViewButton.addEventListener('click', () => setPracticeView('side'));
      insertLensButton.addEventListener('click', attemptSideInsertion);
      document.getElementById('blinkButton').addEventListener('click', blinkAndFinish);
      document.getElementById('wearAgainButton').addEventListener('click', resetWear);
      document.getElementById('wearAttemptClose').addEventListener('click', () => {
        wearAttemptGuide.hidden = true;
        if (DIRECT_SIDE_WEAR) {
          goWearStep(2);
        } else if (wearState.lastFail === 'angle') {
          wearState.step = 3;
          wearState.inserting = false;
          wearState.approach = 0;
          renderSideGeometry();
          renderWearStep();
        } else {
          goWearStep(2);
        }
      });

      function directWearPrompt() {
        if (wearState.upper < 42) {
          setWearFeedback('왼손 중지를 위로 드래그해 윗눈꺼풀을 충분히 올려주세요.');
        } else if (wearState.lower < 42) {
          setWearFeedback('오른손 중지를 아래로 드래그해 아랫눈꺼풀을 충분히 내려주세요.');
        } else {
          setWearFeedback('눈 벌림이 고정됐어요. 오른손 검지를 왼쪽으로 드래그하고, 위아래 움직임으로 렌즈 각도를 맞추세요.');
        }
      }

      function completeDirectSideAttempt() {
        if (wearState.inserting || wearState.success || wearState.step !== 2) return;
        wearState.inserting = true;
        wearState.attemptLocked = true;
        sidePointerDrags.clear();

        if (wearState.upper < 42 || wearState.lower < 42) {
          recordSideFailure('lid');
          return;
        }
        if (Math.abs(wearState.angle) > 6) {
          recordSideFailure('angle');
          return;
        }

        wearState.angle = 0;
        wearState.approach = -92;
        renderSideGeometry();
        sideContactSuccess.style.opacity = '1';
        setWearFeedback('정확해요! 직접 움직인 렌즈가 각막 정면에 고르게 닿았습니다.', 'success');
        vibrate([30, 35, 55]);
        setTimeout(() => {
          wearState.inserting = false;
          wearState.attemptLocked = false;
          goWearStep(4);
          finishWear();
        }, 650);
      }

      sideViewScene.addEventListener('pointerdown', event => {
        if (!DIRECT_SIDE_WEAR || wearState.step !== 2 || wearState.inserting || wearState.success) return;
        const point = toSidePoint(event);
        let type = '';
        if (point.x < 205 && point.y < 185) type = 'upper';
        else if (point.x < 235 && point.y > 285) type = 'lower';
        else if (point.x >= 215 && point.y > 180) type = 'lens';

        if (!type) {
          directWearPrompt();
          return;
        }

        event.preventDefault();
        sideViewScene.setPointerCapture?.(event.pointerId);
        sidePointerDrags.set(event.pointerId, {
          type,
          startX: point.x,
          startY: point.y,
          startUpper: wearState.upper,
          startLower: wearState.lower,
          startApproach: wearState.approach,
          startAngle: wearState.angle
        });

        if (type === 'upper') setWearFeedback('왼손 중지를 위로 움직여 윗눈꺼풀을 올리세요.');
        else if (type === 'lower') setWearFeedback('오른손 중지를 아래로 움직여 아랫눈꺼풀을 내리세요.');
        else setWearFeedback('오른손 검지를 왼쪽으로 천천히 움직이세요. 위아래 이동으로 렌즈 기울기가 바뀝니다.');
      }, { passive: false });

      sideViewScene.addEventListener('pointermove', event => {
        const drag = sidePointerDrags.get(event.pointerId);
        if (!drag || wearState.step !== 2 || wearState.inserting || wearState.success) return;
        event.preventDefault();
        const point = toSidePoint(event);

        if (drag.type === 'upper') {
          wearState.upper = Math.max(0, Math.min(60, drag.startUpper + (drag.startY - point.y) * 1.25));
          renderSideGeometry();
          setWearFeedback(`윗눈꺼풀 ${Math.round(wearState.upper / 60 * 100)}% · 손을 떼어도 이 위치에 고정됩니다.`);
          return;
        }

        if (drag.type === 'lower') {
          wearState.lower = Math.max(0, Math.min(60, drag.startLower + (point.y - drag.startY) * 1.25));
          renderSideGeometry();
          setWearFeedback(`아랫눈꺼풀 ${Math.round(wearState.lower / 60 * 100)}% · 손을 떼어도 이 위치에 고정됩니다.`);
          return;
        }

        const rawApproach = Math.max(-120, Math.min(0, drag.startApproach + (point.x - drag.startX) * 1.08));
        wearState.angle = Math.max(-25, Math.min(25, Math.round(drag.startAngle + (point.y - drag.startY) * .3)));
        const lidIsShort = wearState.upper < 42 || wearState.lower < 42;
        const firstContact = firstSideContactApproach();
        const contactApproach = lidIsShort ? Math.max(firstContact, -76) : firstContact;
        wearState.approach = Math.max(rawApproach, contactApproach);
        renderSideGeometry();
        setWearFeedback(`렌즈 각도 ${wearState.angle > 0 ? '+' : ''}${wearState.angle}° · 0°에 가깝게 맞추며 왼쪽으로 이동하세요.`);

        if (rawApproach <= contactApproach) completeDirectSideAttempt();
      }, { passive: false });

      function releaseDirectSidePointer(event) {
        const drag = sidePointerDrags.get(event.pointerId);
        if (!drag) return;
        sidePointerDrags.delete(event.pointerId);
        sideViewScene.releasePointerCapture?.(event.pointerId);

        if (drag.type === 'lens' && !wearState.inserting && !wearState.success && wearState.step === 2) {
          wearState.approach = 0;
          renderSideGeometry();
          setWearFeedback('렌즈가 각막까지 닿지 않았어요. 검지를 조금 더 왼쪽으로 움직여주세요.', 'error');
        } else if (!wearState.inserting && wearState.step === 2) {
          directWearPrompt();
        }
      }

      sideViewScene.addEventListener('pointerup', releaseDirectSidePointer);
      sideViewScene.addEventListener('pointercancel', releaseDirectSidePointer);

      wearSvg.addEventListener('pointerdown', event => {
        if (wearState.success || wearState.blinking) return;
        const point = toWearPoint(event);
        if (wearState.step === 2) {
          event.preventDefault();
          wearSvg.setPointerCapture?.(event.pointerId);
          wearState.drag = {
            id: event.pointerId,
            type: point.y < 250 ? 'upper' : 'lower',
            startY: point.y,
            startValue: point.y < 250 ? wearState.upper : wearState.lower
          };
          setWearFeedback(point.y < 250 ? '윗눈꺼풀을 위로 원하는 만큼 올리세요.' : '아랫눈꺼풀을 아래로 원하는 만큼 내리세요.');
          return;
        }

        if (wearState.step === 3) {
          const distance = Math.hypot(point.x - wearState.lensX, point.y - wearState.lensY);
          if (distance > 92) {
            setWearFeedback('아래쪽 투명 렌즈 안에 검지를 놓아주세요.', 'error');
            return;
          }
          event.preventDefault();
          wearSvg.setPointerCapture?.(event.pointerId);
          wearState.attemptLocked = false;
          wearState.drag = { id: event.pointerId, type: 'lens', dx: point.x - wearState.lensX, dy: point.y - wearState.lensY };
          setWearFeedback('렌즈를 눈동자 중앙으로 천천히 올리세요.');
        }
      }, { passive: false });

      wearSvg.addEventListener('pointermove', event => {
        if (!wearState.drag || wearState.drag.id !== event.pointerId || wearState.success) return;
        event.preventDefault();
        const point = toWearPoint(event);

        if (wearState.drag.type === 'upper') {
          wearState.upper = Math.max(0, Math.min(60, wearState.drag.startValue - (point.y - wearState.drag.startY)));
          renderWearGeometry();
          setWearFeedback(`윗눈꺼풀 ${Math.round(wearState.upper / 60 * 100)}% · 이제 아랫눈꺼풀도 원하는 만큼 내려보세요.`);
          return;
        }

        if (wearState.drag.type === 'lower') {
          wearState.lower = Math.max(0, Math.min(60, wearState.drag.startValue + (point.y - wearState.drag.startY)));
          renderWearGeometry();
          setWearFeedback(`아랫눈꺼풀 ${Math.round(wearState.lower / 60 * 100)}% · 벌린 정도를 유지한 채 시도할 수 있어요.`);
          return;
        }

        if (wearState.drag.type === 'lens' && !wearState.attemptLocked) {
          wearState.lensX = Math.max(78, Math.min(322, point.x - wearState.drag.dx));
          wearState.lensY = Math.max(170, Math.min(430, point.y - wearState.drag.dy));
          renderWearGeometry();

          const centered = Math.abs(wearState.lensX - 200) < 75;
          if (centered && wearState.lensY <= 322) {
            if (wearState.upper >= 42 && wearState.lower >= 42) {
              wearState.lensX = 200;
              wearState.lensY = 250;
              goWearStep(4);
            } else {
              failWear('속눈썹에 닿았어요!');
            }
          }
        }
      }, { passive: false });

      function releaseWearPointer(event) {
        if (wearState.drag?.id !== event.pointerId) return;
        const wasLens = wearState.drag.type === 'lens';
        wearState.drag = null;
        if (wasLens && !wearState.attemptLocked && wearState.step === 3 && wearState.lensY > 322) {
          setWearFeedback('렌즈가 눈까지 닿지 않았어요. 눈동자 중앙까지 조금 더 올려주세요.', 'error');
          wearState.lensX = 200;
          wearState.lensY = 420;
          renderWearGeometry();
        }
        wearState.attemptLocked = false;
      }

      wearSvg.addEventListener('pointerup', releaseWearPointer);
      wearSvg.addEventListener('pointercancel', releaseWearPointer);
      wearTab.addEventListener('click', () => setMode('wear'));
      removalTab.addEventListener('click', () => setMode('removal'));
      resetButton.addEventListener('click', () => {
        if (activeMode === 'wear') resetWear();
      });

      const removalSvg = document.getElementById('eyeScene');
      const removalAttemptGuide = document.getElementById('removalAttemptGuide');
      const removalAttemptBadge = document.getElementById('removalAttemptBadge');
      const removalAttemptTitle = document.getElementById('removalAttemptTitle');
      const removalAttemptBody = document.getElementById('removalAttemptBody');
      let removalFailures = 0;
      let removalPointers = new Set();
      let removalMaxPointers = 0;

      removalSvg.addEventListener('pointerdown', event => {
        const activeStep = removalPractice.querySelector('[data-progress].active');
        if (activeStep?.dataset.progress !== '3' || document.getElementById('completion').classList.contains('visible')) return;
        removalPointers.add(event.pointerId);
        removalMaxPointers = Math.max(removalMaxPointers, removalPointers.size);
      }, true);

      removalSvg.addEventListener('pointerup', event => {
        if (!removalPointers.has(event.pointerId)) return;
        removalPointers.delete(event.pointerId);
        if (removalPointers.size === 0 && removalMaxPointers < 2) {
          removalFailures += 1;
          if (removalFailures === 2 || removalFailures === 4) {
            removalAttemptBadge.textContent = `${removalFailures}회`;
            if (removalFailures === 2) {
              removalAttemptTitle.textContent = '렌즈 양쪽에 두 손가락을 놓으세요';
              removalAttemptBody.textContent = '검지와 엄지의 손톱 끝이 아니라 넓은 지문 면을 렌즈 양쪽 테두리에 동시에 놓고, 안쪽으로 부드럽게 모아보세요.';
            } else {
              removalAttemptTitle.textContent = '잠시 쉬었다가 다시 시도하세요';
              removalAttemptBody.textContent = '반복하면 눈이 자극될 수 있어요. 잠시 쉬고 손가락을 완전히 말린 뒤 다시 시도하세요. 계속 어렵다면 안경전문가의 도움을 받으세요.';
            }
            removalAttemptGuide.hidden = false;
          }
        }
        if (removalPointers.size === 0) removalMaxPointers = 0;
      }, true);

      document.getElementById('removalAttemptClose').addEventListener('click', () => {
        removalAttemptGuide.hidden = true;
      });
      resetButton.addEventListener('click', () => {
        if (activeMode === 'removal') {
          removalFailures = 0;
          removalPointers.clear();
          removalMaxPointers = 0;
          removalAttemptGuide.hidden = true;
        }
      });
      document.getElementById('againButton').addEventListener('click', () => {
        removalFailures = 0;
        removalPointers.clear();
        removalMaxPointers = 0;
        removalAttemptGuide.hidden = true;
      });

      resetWear();
      setMode('wear');
    })();
  </script>
</body>
</html>
