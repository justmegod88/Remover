      function toSvgPoint(event) {
        const point = svg.createSVGPoint();
        point.x = event.clientX;
        point.y = event.clientY;
        const matrix = svg.getScreenCTM();
        return matrix ? point.matrixTransform(matrix.inverse()) : { x: 0, y: 0 };
      }

      function withinLens(point, extra = 0) {
        const dx = point.x - 200;
        const dy = point.y - (250 + state.lensY);
        return Math.hypot(dx, dy) <= 101 + extra;
      }

      function midpoint(a, b) {
        return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
      }

      function distance(a, b) {
        return Math.hypot(a.x - b.x, a.y - b.y);
      }

      function vibrate(pattern = 22) {
        if ('vibrate' in navigator) navigator.vibrate(pattern);
      }

      function setFeedback(message, type = '') {
        feedback.textContent = message;
        feedback.className = `feedback${type ? ` ${type}` : ''}`;
      }

      function renderGeometry() {
        // 눈꺼풀의 양 끝은 고정하고 가운데 곡선만 열어 실제 눈처럼 보이게 한다.
        const topOuter = 105 - state.upperLidOffset * 1.2;
        const topInner = 122 - state.upperLidOffset * 1.05;
        const bottomOuter = 395 + state.lidOffset * 1.08;
        const bottomInner = 378 + state.lidOffset * .95;
        const eyeOpening = `M24,250 Q200,${topOuter} 376,250 Q200,${bottomOuter} 24,250Z`;

        upperLid.removeAttribute('transform');
        lowerLid.removeAttribute('transform');
        eyeWhite.setAttribute('d', eyeOpening);
        eyeClipPath.setAttribute('d', eyeOpening);
        upperLidOuter.setAttribute('d', `M24,250 Q200,${topOuter} 376,250`);
        upperLidInner.setAttribute('d', `M31,245 Q200,${topInner} 369,245`);
        upperLidHit.setAttribute('d', `M24,250 Q200,${topOuter} 376,250`);
        lowerLidOuter.setAttribute('d', `M24,250 Q200,${bottomOuter} 376,250`);
        lowerLidInner.setAttribute('d', `M31,255 Q200,${bottomInner} 369,255`);
        lowerLidHit.setAttribute('d', `M24,250 Q200,${bottomOuter} 376,250`);
        lowerCrease.setAttribute('d', `M46,291 Q200,${420 + state.lidOffset * .75} 354,291`);
        upperLashes.setAttribute('transform', `translate(0 ${-state.upperLidOffset * .72})`);
        lowerLashes.setAttribute('transform', `translate(0 ${state.lidOffset * .7})`);

        // 렌즈를 아래로 미는 동안 시선은 위를 향한다.
        // 렌즈가 흰자위로 내려갈수록 눈동자는 위를 보되,
        // 검은 동공이 너무 위로 붙지 않도록 상승 폭을 제한한다.
        const gazeUp = state.success ? 115 : Math.min(115, state.lensY * 1.7);
        irisGroup.setAttribute('transform', `translate(0 ${-gazeUp})`);
        lensPosition.setAttribute('transform', `translate(0 ${state.lensY})`);
        lensFold.style.transform = `scaleX(${state.fold})`;
      }

      function renderStep() {
        const current = copy[state.step];
        stepNumber.textContent = state.step;
        instructionTitle.textContent = current.title;
        instructionBody.textContent = current.body;
        setFeedback(current.feedback);
        progressList.classList.toggle('all-done', state.success);

        progressItems.forEach((item, index) => {
          const number = index + 1;
          item.classList.toggle('active', number === state.step);
          item.classList.toggle('done', number < state.step || state.success);
        });

        for (let i = 1; i <= 3; i++) {
          const isCurrentGuide = i === state.step;
          // 완료한 가이드는 애니메이션이 남지 않도록 화면에서 완전히 제외한다.
          guides[i].style.display = isCurrentGuide ? '' : 'none';
          guides[i].style.opacity = isCurrentGuide ? '1' : '0';
          guides[i].style.pointerEvents = 'none';
        }
      }

      function goToStep(next) {
        state.step = next;
        state.drag = null;
        state.pinch = null;
        state.fold = 1;
        renderGeometry();
        renderStep();
        vibrate();
      }

      function showMarker(index, event) {
        if (!markers[index]) return;
        const rect = svg.getBoundingClientRect();
        markers[index].style.display = 'block';
        markers[index].style.left = `${event.clientX - rect.left}px`;
        markers[index].style.top = `${event.clientY - rect.top}px`;
      }

      function hideMarkers() {
        markers.forEach(marker => { marker.style.display = 'none'; });
      }

      function updateMarkers() {
        if (state.step === 3) {
          hideMarkers();
          return;
        }
        const rect = svg.getBoundingClientRect();
        [...state.pointers.values()].slice(0, 2).forEach((pointer, index) => {
          markers[index].style.display = 'block';
          markers[index].style.left = `${pointer.clientX - rect.left}px`;
          markers[index].style.top = `${pointer.clientY - rect.top}px`;
        });
        for (let i = state.pointers.size; i < markers.length; i++) markers[i].style.display = 'none';
      }

      function reset() {
        clearTimeout(state.oneFingerTimer);
        clearTimeout(state.pinchHoldTimer);
        clearTimeout(state.touchFallbackTimer);
        state.step = 1;
        state.upperLidOffset = 0;
        state.lidOffset = 0;
        state.lensY = 0;
        state.fold = 1;
        state.pointers.clear();
        state.drag = null;
        state.pinch = null;
        state.success = false;
        lensPosition.style.opacity = '1';
        completion.classList.remove('visible');
        completion.setAttribute('aria-hidden', 'true');
        progressList.classList.remove('all-done');
        hideMarkers();
        renderGeometry();
        renderStep();
      }

      function finish() {
        if (state.success) return;
        state.success = true;
        clearTimeout(state.oneFingerTimer);
        clearTimeout(state.pinchHoldTimer);
        clearTimeout(state.touchFallbackTimer);
        setFeedback('정확해요! 손가락의 넓은 면으로 렌즈 양쪽을 부드럽게 모았어요.', 'success');
        progressItems.forEach(item => {
          item.classList.add('done');
          item.classList.remove('active');
        });
        progressList.classList.add('all-done');
        guides[3].style.display = 'none';
        guides[3].style.opacity = '0';
        vibrate([35, 40, 70]);

        const start = performance.now();
        const startY = state.lensY;
        const duration = 620;
        function animate(now) {
          const raw = Math.min(1, (now - start) / duration);
          const eased = 1 - Math.pow(1 - raw, 3);
          state.lensY = startY - 125 * eased;
          state.fold = 1 - .72 * eased;
          lensPosition.style.opacity = String(1 - .82 * eased);
          renderGeometry();
          if (raw < 1) requestAnimationFrame(animate);
          else {
            completion.classList.add('visible');
            completion.setAttribute('aria-hidden', 'false');
          }
        }
        requestAnimationFrame(animate);
      }

      function beginPinchIfReady() {
        // iPhone에서는 두 번째 손가락의 좌표 판정이 불안정할 수 있어
        // 마지막 단계에서는 두 포인터가 동시에 존재하면 바로 핀치로 인정한다.
        const entries = [...state.pointers.entries()].sort((a, b) => a[1].clientX - b[1].clientX);
        if (entries.length < 2) return;

        const left = entries[0];
        const right = entries[entries.length - 1];
        const a = left[1];
        const b = right[1];
        const startClientGap = b.clientX - a.clientX;
        const startDistance = distance(a, b);

        state.pinch = {
          ids: [left[0], right[0]],
          startDistance,
          startClientGap,
          startLeftClientX: a.clientX,
          startRightClientX: b.clientX,
          startLeftClientY: a.clientY,
          startRightClientY: b.clientY
        };
        clearTimeout(state.oneFingerTimer);
        setFeedback('두 손가락이 인식됐어요! 안쪽으로 살짝 모아주세요.');
        state.fold = .86;
        renderGeometry();
        vibrate(16);

        clearTimeout(state.pinchHoldTimer);
        state.pinchHoldTimer = setTimeout(() => {
          const [leftId, rightId] = state.pinch?.ids || [];
          if (state.step === 3 && !state.success && state.pointers.has(leftId) && state.pointers.has(rightId)) finish();
        }, 320);
      }

      svg.addEventListener('pointerdown', (event) => {
        if (state.success) return;
        event.preventDefault();
        if (state.step !== 3) svg.setPointerCapture?.(event.pointerId);
        const point = toSvgPoint(event);
        state.pointers.set(event.pointerId, { ...point, clientX: event.clientX, clientY: event.clientY });
        updateMarkers();

        if (state.step === 1) {
          if (point.y < 300 || point.y > 430) {
            setFeedback('아랫눈꺼풀의 파란 원에 오른손 중지를 놓아주세요.', 'error');
            return;
          }
          state.drag = { type: 'lowerLid', id: event.pointerId, startY: point.y, startOffset: state.lidOffset };
          setFeedback('오른손 중지를 그대로 아래로 내려주세요.');
          return;
        }

        if (state.step === 2) {
          if (!withinLens(point, 8)) {
            setFeedback('투명한 렌즈 안쪽에 손가락을 놓아주세요.', 'error');
            return;
          }
          state.drag = { type: 'lens', id: event.pointerId, startY: point.y, startLensY: state.lensY };
          setFeedback('렌즈를 아래 흰자위 방향으로 천천히 밀어주세요.');
          return;
        }

        if (state.step === 3) {
          beginPinchIfReady();
          if (state.pointers.size === 1) {
            clearTimeout(state.oneFingerTimer);
            state.oneFingerTimer = setTimeout(() => {
              if (state.step === 3 && state.pointers.size === 1 && !state.success) {
                setFeedback('반대쪽 렌즈 테두리에도 다른 손가락을 놓아주세요.', 'error');
              }
            }, 900);
          }
        }
      }, { passive: false });

      svg.addEventListener('pointermove', (event) => {
        if (!state.pointers.has(event.pointerId) || state.success) return;
        event.preventDefault();
        const point = toSvgPoint(event);
        state.pointers.set(event.pointerId, { ...point, clientX: event.clientX, clientY: event.clientY });
        updateMarkers();

        if (state.step === 1 && state.drag?.id === event.pointerId) {
          const dy = point.y - state.drag.startY;
          state.lidOffset = Math.max(0, Math.min(70, state.drag.startOffset + dy));
          renderGeometry();
          if (state.lidOffset >= 34) {
            state.lidOffset = 66;
            renderGeometry();
            goToStep(2);
          }
          return;
        }

        if (state.step === 2 && state.drag?.id === event.pointerId) {
          const dy = point.y - state.drag.startY;
          state.lensY = Math.max(0, Math.min(112, state.drag.startLensY + dy));
          // 별도의 상안검 단계 없이 렌즈를 내리는 거리만큼 상안검이 자동으로 열린다.
          state.upperLidOffset = Math.min(60, state.lensY);
          renderGeometry();
          if (dy < -12) setFeedback('위쪽이 아니라 아래 흰자위 방향으로 밀어주세요.', 'error');
          if (state.lensY >= 54) {
            state.lensY = 60;
            state.upperLidOffset = 60;
            renderGeometry();
            goToStep(3);
          }
          return;
        }

        if (state.step === 3) {
          if (!state.pinch) beginPinchIfReady();
          if (!state.pinch) return;
          const [idA, idB] = state.pinch.ids;
          const a = state.pointers.get(idA);
          const b = state.pointers.get(idB);
          if (!a || !b) return;
          const currentDistance = distance(a, b);
          const ratio = currentDistance / state.pinch.startDistance;
          const closedDistance = state.pinch.startDistance - currentDistance;
          const currentClientGap = b.clientX - a.clientX;
          const horizontalClose = (a.clientX - state.pinch.startLeftClientX) + (state.pinch.startRightClientX - b.clientX);
          const clientClosedDistance = state.pinch.startClientGap - currentClientGap;
          const totalMotion = Math.abs(a.clientX - state.pinch.startLeftClientX)
            + Math.abs(b.clientX - state.pinch.startRightClientX)
            + Math.abs(a.clientY - state.pinch.startLeftClientY)
            + Math.abs(b.clientY - state.pinch.startRightClientY);
          const closeProgress = Math.max(4, horizontalClose, clientClosedDistance, closedDistance, totalMotion);

          // 작은 움직임도 눈에 보이도록 렌즈 접힘을 확대해서 표시한다.
          state.fold = Math.max(.58, Math.min(1, 1 - closeProgress / 28));
          renderGeometry();
          // 두 손가락이 함께 인식된 뒤 아주 작은 움직임만 생겨도 성공한다.
          if (totalMotion >= 3 || horizontalClose >= 2 || clientClosedDistance >= 2 || closedDistance >= 3 || ratio <= .98) finish();
        }
      }, { passive: false });

      function releasePointer(event) {
        const completedPinchGesture = state.pinch?.ids.includes(event.pointerId) && !state.success;
        state.pointers.delete(event.pointerId);
        updateMarkers();
        if (state.drag?.id === event.pointerId) state.drag = null;
        // 두 손가락이 한 번 함께 인식됐다면 손가락을 떼는 동작도 핀치 완료로 인정한다.
        if (completedPinchGesture) finish();
        if (state.pointers.size === 0) clearTimeout(state.oneFingerTimer);
      }

      // iPhone Safari에서 두 번째 PointerEvent가 누락되는 경우를 위한 멀티터치 보조 인식.
      svg.addEventListener('touchstart', event => {
        if (state.step !== 3 || state.success || event.touches.length < 2) return;
        event.preventDefault();
        clearTimeout(state.oneFingerTimer);
        clearTimeout(state.touchFallbackTimer);
        setFeedback('두 손가락이 인식됐어요! 렌즈를 살짝 집어주세요.');
        state.fold = .82;
        renderGeometry();
        vibrate(16);
        state.touchFallbackTimer = setTimeout(() => {
          if (state.step === 3 && !state.success) finish();
        }, 220);
      }, { passive: false });

      svg.addEventListener('touchmove', event => {
        if (state.step !== 3 || state.success || event.touches.length < 2) return;
        event.preventDefault();
        finish();
      }, { passive: false });

      svg.addEventListener('pointerup', releasePointer);
      svg.addEventListener('pointercancel', releasePointer);
      document.getElementById('resetButton').addEventListener('click', reset);
      document.getElementById('againButton').addEventListener('click', reset);

      function filterFaq() {
        const query = faqSearch.value.trim().toLocaleLowerCase('ko-KR').replace(/\s+/g, '');
        let visible = 0;
        faqItems.forEach(item => {
          const searchable = `${item.dataset.search || ''} ${item.textContent}`.toLocaleLowerCase('ko-KR').replace(/\s+/g, '');
          const matches = !query || searchable.includes(query);
          item.hidden = !matches;
          if (matches) visible += 1;
        });
        faqCount.textContent = query ? `검색 결과 ${visible}개` : `${visible}개 질문`;
        faqEmpty.hidden = visible !== 0;
      }

      function openFaq() {
        faqModal.hidden = false;
        document.body.classList.add('faq-open');
        faqButton.setAttribute('aria-expanded', 'true');
        requestAnimationFrame(() => faqSearch.focus());
      }

      function closeFaq() {
        faqModal.hidden = true;
        document.body.classList.remove('faq-open');
        faqButton.setAttribute('aria-expanded', 'false');
        faqButton.focus();
      }

      faqButton.setAttribute('aria-expanded', 'false');
      faqButton.addEventListener('click', openFaq);
      faqClose.addEventListener('click', closeFaq);
      faqSearch.addEventListener('input', filterFaq);
      faqModal.addEventListener('click', event => {
        if (event.target === faqModal) closeFaq();
      });
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && !faqModal.hidden) closeFaq();
      });

      renderGeometry();
      renderStep();
      filterFaq();
    })();
  </script>
