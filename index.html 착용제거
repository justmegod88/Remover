      const state = {
        step: 1,
        upperLidOffset: 0,
        lidOffset: 0,
        lensY: 0,
        fold: 1,
        pointers: new Map(),
        drag: null,
        pinch: null,
        oneFingerTimer: null,
        pinchHoldTimer: null,
        touchFallbackTimer: null,
        success: false
