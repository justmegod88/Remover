<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#0b2f58">
  <title>콘택트렌즈 착용·제거 연습</title>
  <style>
    :root {
      --navy: #0b2f58;
      --blue: #1268ad;
      --sky: #eaf5ff;
      --line: #d7e5f2;
      --text: #172536;
      --muted: #66788c;
      --success: #11865f;
      --danger: #c84545;
      --shadow: 0 18px 50px rgba(14, 50, 82, 0.13);
    }

    * { box-sizing: border-box; }

    html, body { margin: 0; min-height: 100%; }

    body {
      background: linear-gradient(180deg, #e9f4ff 0%, #f7fbff 48%, #edf6fc 100%);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans KR", sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    button, input { font: inherit; }

    body.faq-open { overflow: hidden; }

    .app {
      width: min(100%, 560px);
      min-height: 100dvh;
      margin: 0 auto;
      background: rgba(255, 255, 255, 0.96);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .topbar {
      padding: calc(18px + env(safe-area-inset-top)) 20px 20px;
      color: #fff;
      background:
        radial-gradient(circle at 90% 10%, rgba(89, 192, 240, 0.35), transparent 30%),
        linear-gradient(135deg, #092b50, #0b5d93);
    }

    .topbar-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .eyebrow {
      margin: 0 0 5px;
      color: #aee4ff;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.12em;
    }

    h1 {
      margin: 0;
      font-size: clamp(23px, 6vw, 30px);
      line-height: 1.18;
      letter-spacing: -0.04em;
    }

    .top-actions {
      display: flex;
      flex: 0 0 auto;
      gap: 8px;
    }

    .faq-button,
    .reset-button {
      flex: 0 0 auto;
      min-width: 52px;
      min-height: 44px;
      padding: 10px 13px;
      border: 1px solid rgba(255, 255, 255, 0.35);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.13);
      color: #fff;
      cursor: pointer;
    }

    .faq-button {
      border-color: rgba(174, 228, 255, .58);
      background: rgba(174, 228, 255, .17);
      font-weight: 800;
    }

    .faq-button:active,
    .reset-button:active { transform: translateY(1px); }

    main { padding: 18px 16px calc(28px + env(safe-area-inset-bottom)); }

    .progress-list {
      display: flex;
      gap: 7px;
      margin: 0 0 14px;
      padding: 0;
      list-style: none;
    }

    .progress-list li {
      flex: 1 1 0;
      min-width: 0;
      padding: 9px 4px;
      border-radius: 12px;
      background: #eef3f7;
      color: #738397;
      text-align: center;
      font-size: 12px;
      font-weight: 700;
      transition: 180ms ease;
    }

    .progress-list li.active {
      background: #dceeff;
      color: #075993;
      box-shadow: inset 0 0 0 1px #add8f6;
    }

    .progress-list li.done {
      display: none;
    }

    .progress-list.all-done { display: none; }

    .coach {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      min-height: 82px;
      margin-bottom: 14px;
      padding: 14px;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: #fff;
      box-shadow: 0 8px 24px rgba(25, 74, 111, 0.08);
    }

    .step-number {
      display: grid;
      flex: 0 0 38px;
      width: 38px;
      height: 38px;
      place-items: center;
      border-radius: 50%;
      background: var(--navy);
      color: #fff;
      font-size: 15px;
      font-weight: 800;
    }

    .coach strong {
      display: block;
      margin-bottom: 4px;
      font-size: 16px;
      line-height: 1.35;
    }

    .coach p {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.45;
    }

    .simulator {
      position: relative;
      overflow: hidden;
      border-radius: 28px;
      background: #173047;
      box-shadow: inset 0 0 0 1px rgba(255,255,255,.16), 0 14px 30px rgba(12, 44, 72, .18);
      isolation: isolate;
    }

    #eyeScene {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 5;
      max-height: 640px;
      touch-action: none;
      user-select: none;
      -webkit-user-select: none;
      cursor: grab;
    }

    #eyeScene:active { cursor: grabbing; }

    #lensPosition,
    #lensFold,
    #lowerLid,
    #guideLayer { transition: opacity 180ms ease; }

    #lensFold {
      transform-box: view-box;
      transform-origin: 200px 250px;
    }

    .touch-marker {
      position: absolute;
      z-index: 8;
      display: none;
      width: 56px;
      height: 56px;
      margin: -28px 0 0 -28px;
      border: 3px solid rgba(255, 255, 255, .95);
      border-radius: 50%;
      background: rgba(78, 169, 230, .28);
      box-shadow: 0 0 0 8px rgba(78, 169, 230, .13);
      pointer-events: none;
    }

    .feedback {
      position: absolute;
      z-index: 10;
      right: 14px;
      bottom: 14px;
      left: 14px;
      min-height: 54px;
      padding: 12px 14px;
      border: 1px solid rgba(255,255,255,.28);
      border-radius: 16px;
      background: rgba(5, 29, 50, .84);
      color: #fff;
      font-size: 14px;
      font-weight: 700;
      line-height: 1.4;
      text-align: center;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      transition: 180ms ease;
    }

    .feedback.error { background: rgba(139, 34, 42, .9); }
    .feedback.success { background: rgba(5, 108, 74, .92); }
    .feedback[hidden] { display: none; }

    .completion {
      position: absolute;
      z-index: 12;
      inset: 0;
      display: grid;
      align-content: center;
      justify-items: center;
      padding: 30px;
      background: rgba(5, 37, 61, .78);
      color: #fff;
      text-align: center;
      opacity: 0;
      pointer-events: none;
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      transition: opacity 260ms ease;
    }

    .completion.visible { opacity: 1; pointer-events: auto; }

    .checkmark {
      display: grid;
      width: 72px;
      height: 72px;
      margin-bottom: 14px;
      place-items: center;
      border-radius: 50%;
      background: #20a978;
      font-size: 38px;
      box-shadow: 0 10px 30px rgba(9, 27, 39, .25);
    }

    .completion h2 { margin: 0 0 8px; font-size: 28px; }
    .completion p { margin: 0 0 22px; max-width: 310px; color: #d7efff; line-height: 1.5; }

    .again-button {
      min-width: 180px;
      min-height: 48px;
      padding: 12px 20px;
      border: 0;
      border-radius: 14px;
      background: #fff;
      color: var(--navy);
      font-weight: 800;
      cursor: pointer;
    }

    .safety-note {
      margin: 14px 4px 0;
      color: #6f7f91;
      font-size: 11px;
      line-height: 1.5;
      text-align: center;
    }

    .mode-tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin: 0 0 14px;
      padding: 5px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: #eef4f9;
    }

    .mode-tab {
      min-height: 46px;
      border: 0;
      border-radius: 12px;
      background: transparent;
      color: #6d7f91;
      font-weight: 800;
      cursor: pointer;
    }

    .mode-tab.active {
      background: #fff;
      color: #075993;
      box-shadow: 0 4px 14px rgba(18, 72, 111, .12), inset 0 0 0 1px #b9dbf2;
    }

    .practice-panel[hidden] { display: none; }

    #wearEyeScene,
    #sideViewScene {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 5;
      max-height: 640px;
      touch-action: none;
      user-select: none;
      -webkit-user-select: none;
      cursor: grab;
    }

    #wearEyeScene:active { cursor: grabbing; }

    #wearEyeScene[hidden],
    .side-view-stage[hidden],
    .video-pip[hidden] { display: none; }

    .side-view-stage {
      position: relative;
      width: 100%;
      aspect-ratio: 36 / 41;
      max-height: 640px;
      overflow: hidden;
      background: #173047;
    }

    #sideViewScene {
      aspect-ratio: 36 / 41;
    }

    .video-pip {
      position: absolute;
      z-index: 18;
      top: 14px;
      right: 14px;
      width: min(40%, 170px);
      overflow: hidden;
      border: 3px solid rgba(255,255,255,.94);
      border-radius: 17px;
      background: #082a48;
      box-shadow: 0 8px 24px rgba(4, 25, 43, .28);
    }

    .video-pip span {
      display: block;
      padding: 7px 9px;
      color: #fff;
      font-size: 11px;
      font-weight: 800;
      text-align: center;
    }

    .video-pip iframe {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      border: 0;
      background: #061d31;
    }

    .wear-control-dock {
      min-height: 62px;
      margin: -2px 0 14px;
      padding: 7px;
      border: 1px solid var(--line);
      border-radius: 17px;
      background: #eef5fb;
      box-shadow: 0 6px 18px rgba(25, 74, 111, .07);
    }

    .wear-control-dock[hidden] { display: none; }

    .wear-actions {
      position: static;
      display: flex;
      justify-content: center;
      gap: 8px;
    }

    .wear-actions[hidden],
    .opening-meter[hidden] { display: none; }

    .wear-action {
      flex: 1 1 auto;
      min-height: 46px;
      padding: 10px 15px;
      border: 1px solid rgba(255,255,255,.45);
      border-radius: 14px;
      background: rgba(255,255,255,.94);
      color: var(--navy);
      font-size: 13px;
      font-weight: 850;
      box-shadow: 0 4px 12px rgba(4, 29, 49, .12);
      cursor: pointer;
    }

    .wear-action.secondary {
      background: #0b3f69;
      color: #fff;
    }

    .wear-action:disabled {
      cursor: wait;
      opacity: .68;
    }

    .orientation-actions .wear-action {
      flex: 1 1 0;
      min-width: 0;
      min-height: 190px;
      overflow: hidden;
      padding: 0;
      border: 1px solid #c2d9e9;
      background: linear-gradient(180deg, #fff 0%, #f4faff 100%);
      text-align: left;
      box-shadow: 0 7px 18px rgba(10, 55, 88, .1);
    }

    .orientation-card-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 38px;
      padding: 8px 10px;
      background: linear-gradient(135deg, #0b3d67, #1374aa);
      color: #fff;
      font-size: 13px;
      font-weight: 900;
    }

    .orientation-card.wrong .orientation-card-title {
      background: linear-gradient(135deg, #5a6570, #7d8995);
    }

    .orientation-card-title small {
      padding: 3px 6px;
      border-radius: 999px;
      background: rgba(255,255,255,.18);
      font-size: 9px;
      letter-spacing: .02em;
    }

    .orientation-visual {
      display: block;
      width: 100%;
      height: 112px;
      background:
        radial-gradient(circle at 50% 18%, rgba(149, 227, 248, .22), transparent 42%),
        linear-gradient(180deg, #fafeff, #e8f4fa);
    }

    .orientation-caption {
      display: block;
      padding: 8px 8px 9px;
      color: #19364d;
      font-size: 11px;
      font-weight: 900;
      line-height: 1.25;
      text-align: center;
    }

    .orientation-caption small {
      display: block;
      margin-top: 3px;
      color: #6b7f90;
      font-size: 9px;
      font-weight: 750;
    }

    .orientation-card.correct:active {
      border-color: #2aa67c;
      box-shadow: 0 0 0 3px rgba(42,166,124,.18);
    }

    .orientation-card.wrong:active {
      border-color: #cf555f;
      box-shadow: 0 0 0 3px rgba(207,85,95,.16);
    }

    .orientation-card.wrong.invalid {
      border-color: #d34c59;
      background: #fff1f2;
      box-shadow: 0 0 0 3px rgba(211,76,89,.16);
      animation: orientationWrong 360ms ease;
    }

    @keyframes orientationWrong {
      0%, 100% { transform: translateX(0); }
      30% { transform: translateX(-5px); }
      65% { transform: translateX(5px); }
    }

    .angle-actions {
      flex-direction: column;
      gap: 7px;
    }

    .view-switch {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
      padding: 4px;
      border-radius: 13px;
      background: #dfeaf3;
    }

    .view-switch button {
      min-height: 38px;
      border: 0;
      border-radius: 10px;
      background: transparent;
      color: #667b8f;
      font-size: 12px;
      font-weight: 850;
      cursor: pointer;
    }

    .view-switch button.active {
      background: #fff;
      color: #075993;
      box-shadow: 0 3px 10px rgba(20, 72, 108, .12);
    }

    .angle-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 3px 5px 0;
      color: #243d55;
      font-size: 12px;
      font-weight: 800;
    }

    .angle-value {
      min-width: 52px;
      padding: 5px 9px;
      border-radius: 999px;
      background: #dcefff;
      color: #075993;
      text-align: center;
      font-size: 14px;
      font-weight: 900;
    }

    .angle-adjust-row,
    .angle-button-row {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .angle-nudge {
      width: 48px;
      height: 42px;
      flex: 0 0 48px;
      border: 1px solid #b8d4e8;
      border-radius: 12px;
      background: #fff;
      color: #0b4f7d;
      font-weight: 900;
      cursor: pointer;
    }

    #angleSlider {
      width: 100%;
      accent-color: #1479b8;
      cursor: grab;
    }

    .angle-button-row .wear-action { flex: 1 1 0; }

    .side-view-label {
      position: absolute;
      z-index: 5;
      top: 14px;
      left: 14px;
      padding: 7px 11px;
      border: 1px solid rgba(255,255,255,.4);
      border-radius: 999px;
      background: rgba(6,42,70,.78);
      color: #fff;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .05em;
    }

    .opening-meter {
      position: absolute;
      z-index: 15;
      top: 14px;
      left: 14px;
      width: 145px;
      padding: 9px 11px;
      border: 1px solid rgba(255,255,255,.36);
      border-radius: 14px;
      background: rgba(7,39,66,.76);
      color: #fff;
      font-size: 11px;
      font-weight: 800;
      backdrop-filter: blur(8px);
    }

    .meter-track {
      height: 7px;
      margin-top: 6px;
      overflow: hidden;
      border-radius: 999px;
      background: rgba(255,255,255,.23);
    }

    .meter-fill {
      width: 0;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, #70c9f3, #64e0b0);
      transition: width 100ms linear;
    }

    .attempt-guide {
      position: absolute;
      z-index: 40;
      inset: 0;
      display: grid;
      align-content: center;
      padding: 26px;
      background: rgba(4, 28, 48, .7);
      backdrop-filter: blur(4px);
    }

    .attempt-guide[hidden] { display: none; }

    .attempt-guide-card {
      padding: 22px 19px 18px;
      border: 1px solid rgba(255,255,255,.35);
      border-radius: 22px;
      background: #fff;
      color: var(--text);
      text-align: center;
      box-shadow: 0 18px 45px rgba(1, 20, 35, .32);
    }

    .attempt-guide-badge {
      display: grid;
      width: 48px;
      height: 48px;
      margin: 0 auto 11px;
      place-items: center;
      border-radius: 50%;
      background: #e9f5ff;
      color: #08649f;
      font-size: 18px;
      font-weight: 900;
    }

    .attempt-guide h3 { margin: 0 0 8px; font-size: 20px; }
    .attempt-guide p { margin: 0 0 16px; color: #53677a; font-size: 13px; line-height: 1.55; }

    .attempt-guide button {
      min-width: 150px;
      min-height: 44px;
      border: 0;
      border-radius: 13px;
      background: var(--navy);
      color: #fff;
      font-weight: 800;
      cursor: pointer;
    }

    .lash-hit { animation: lashHit .5s ease 2; }

    @keyframes lashHit {
      0%, 100% { opacity: .2; }
      50% { opacity: 1; }
    }

    .faq-modal[hidden] { display: none; }

    .faq-modal {
      position: fixed;
      z-index: 1000;
      inset: 0;
      display: grid;
      align-items: end;
      padding-top: env(safe-area-inset-top);
      background: rgba(4, 23, 40, .62);
      backdrop-filter: blur(7px);
      -webkit-backdrop-filter: blur(7px);
    }

    .faq-sheet {
      display: flex;
      width: min(100%, 640px);
      max-height: 94dvh;
      margin: 0 auto;
      flex-direction: column;
      overflow: hidden;
      border-radius: 28px 28px 0 0;
      background: #f8fbfe;
      box-shadow: 0 -18px 60px rgba(4, 23, 40, .28);
    }

    .faq-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      padding: 20px 20px 14px;
      color: #fff;
      background: linear-gradient(135deg, #092b50, #0b659b);
    }

    .faq-kicker {
      margin: 0 0 3px;
      color: #aee4ff;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .12em;
    }

    .faq-header h2 { margin: 0; font-size: 24px; letter-spacing: -.035em; }

    .faq-close {
      display: grid;
      width: 42px;
      height: 42px;
      flex: 0 0 42px;
      place-items: center;
      border: 1px solid rgba(255,255,255,.35);
      border-radius: 50%;
      background: rgba(255,255,255,.14);
      color: #fff;
      font-size: 20px;
      cursor: pointer;
    }

    .faq-search-wrap {
      padding: 14px 18px 12px;
      border-bottom: 1px solid var(--line);
      background: #fff;
    }

    .faq-search-wrap label {
      display: block;
      margin-bottom: 7px;
      color: #33465a;
      font-size: 12px;
      font-weight: 800;
    }

    .faq-search-row { position: relative; }

    .faq-search-row::before {
      position: absolute;
      top: 50%;
      left: 14px;
      color: #6f8296;
      content: "⌕";
      font-size: 24px;
      transform: translateY(-55%);
      pointer-events: none;
    }

    #faqSearch {
      width: 100%;
      min-height: 48px;
      padding: 11px 14px 11px 44px;
      border: 1px solid #bfd5e7;
      border-radius: 14px;
      outline: none;
      background: #f7fbff;
      color: var(--text);
      font-size: 16px;
    }

    #faqSearch:focus { border-color: #3493cd; box-shadow: 0 0 0 3px rgba(52,147,205,.14); }

    .faq-count { margin: 7px 2px 0; color: var(--muted); font-size: 11px; }

    .faq-list {
      flex: 1 1 auto;
      min-height: 0;
      overflow: auto;
      padding: 5px 18px 24px;
      overscroll-behavior: contain;
    }

    .faq-item {
      border-bottom: 1px solid #dfe9f1;
      background: transparent;
    }

    .faq-item[hidden] { display: none; }

    .faq-item summary {
      position: relative;
      padding: 16px 38px 16px 2px;
      color: #193148;
      cursor: pointer;
      font-size: 15px;
      font-weight: 800;
      line-height: 1.4;
      list-style: none;
    }

    .faq-item summary::-webkit-details-marker { display: none; }

    .faq-item summary::after {
      position: absolute;
      top: 14px;
      right: 4px;
      color: #1979b5;
      content: "+";
      font-size: 23px;
      font-weight: 500;
    }

    .faq-item[open] summary::after { content: "−"; }

    .faq-item p {
      margin: -3px 0 16px;
      padding: 0 34px 0 2px;
      color: #52677b;
      font-size: 13px;
      line-height: 1.65;
    }

    .faq-tag {
      display: inline-block;
      margin-right: 7px;
      padding: 3px 7px;
      border-radius: 999px;
      background: #e2f2ff;
      color: #12669e;
      font-size: 10px;
      vertical-align: 1px;
    }

    .faq-empty {
      padding: 38px 24px;
      color: var(--muted);
      text-align: center;
    }

    .faq-sources {
      padding: 12px 18px calc(12px + env(safe-area-inset-bottom));
      border-top: 1px solid var(--line);
      background: #eef6fc;
      color: #63778a;
      font-size: 10px;
      line-height: 1.55;
    }

    .faq-sources p { margin: 0 0 5px; }
    .faq-sources p:last-child { margin-bottom: 0; }
    .faq-sources a { color: #0b639b; font-weight: 700; }

    .pulse { animation: pulse 1.25s ease-in-out infinite; }
    .bob { animation: bob 1.25s ease-in-out infinite; }

    @keyframes pulse {
      0%, 100% { opacity: .45; }
      50% { opacity: 1; }
    }

    @keyframes bob {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(10px); }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    }

    @media (max-width: 380px) {
      main { padding-inline: 10px; }
      .topbar { padding-inline: 14px; }
      .topbar-row { gap: 9px; }
      .top-actions { gap: 5px; }
